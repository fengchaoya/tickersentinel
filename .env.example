# tickersentinel 的配置模板：复制为 .env 后填写（.env 已在 .gitignore 中，不会提交到 git）
#   cp .env.example .env
# 等号后面直接填值，不需要加引号（值里可以有空格）；没填的项对应功能会自动跳过或降级。
# 每一项的用途和申请方法见 README「配置」一节；填好后运行 .venv/bin/tsen check 检查。

# —— 自己的配置（可选）：仓库里的 config/ 是通用示例。把它复制成 config.local/（不进 git），在这里指过去：
#    cp -R config config.local     然后取消下一行的注释（相对路径按项目根目录算）——
# TICKERSENTINEL_SETTINGS=config.local/settings.yaml

# —— SEC 公告：请求头里的联系方式（SEC 要求），填“项目名 + 你的邮箱” ——
SEC_EDGAR_USER_AGENT=

# —— 美国劳工统计局（BLS）发布日程：CPI / PPI / 非农 / JOLTS 的公布时间。BLS 同样要求请求头带联系邮箱，
#    格式同上（可以和 SEC 那行填一样的）；留空则事件日历里没有这几项 ——
BLS_USER_AGENT=

# —— 云端大模型（可选；默认用本机 LM Studio，不需要密钥）——
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# —— 新闻 / 财报日历 ——  https://finnhub.io （免费注册）
FINNHUB_API_KEY=

# —— 行情兜底与日线官方收盘价（可选）：yfinance 出错或缺代码时由 Alpaca 补，日线收盘价换成 SIP 官方收盘。
#    主源仍是 yfinance，不要把 provider 改成 alpaca（免费 IEX 的盘前盘后只有美东约 08:00–17:00）——  https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# —— 推送：Telegram（尚未实现，先留空）——  在 Telegram 里找 @BotFather 创建机器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# —— 推送与对话：飞书（可用；同一个应用也用于飞书日历 / 多维表格同步）——  open.feishu.cn 自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# —— 韩国 DART 公告（尚未实现）——  https://opendart.fss.or.kr
OPENDART_API_KEY=
